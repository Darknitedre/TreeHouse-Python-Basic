# ---- Supabase (client-safe: shipped to the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Supabase (server-only: NEVER expose to the browser) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Anthropic (server-only) ----
ANTHROPIC_API_KEY=sk-ant-...
# Model used for post analysis / weekly reports. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Optional embeddings provider for semantic search (server-only) ----
# If unset, the app falls back to a deterministic local embedding so it still
# runs; set this in production for real semantic search.
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=voyage-3
EMBEDDINGS_URL=https://api.voyageai.com/v1/embeddings

# ---- App ----
NEXT_PUBLIC_APP_NAME=Social Action Vault
